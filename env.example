# Copy this file to .env and fill in your actual values.
# .env is in .gitignore — it will NEVER be pushed to GitHub.
# On Railway, add these same keys in the Variables tab instead.

# Get from: console.groq.com/ → Get API Key (free)
GROQ_API_KEY=your_groq_api_key_here

# Get from: cloud.qdrant.io → your cluster → Connection details
QDRANT_URL=https://xxxx-xxxx.aws.cloud.qdrant.io

# Get from: cloud.qdrant.io → your cluster → API Keys
QDRANT_API_KEY=your_qdrant_api_key_here

# Optional — default is 500. Lower this if Railway runs out of memory.
MAX_FILES=500

# Optional — Groq chat model. Empty uses the default below.
GROQ_MODEL=openai/gpt-oss-120b

# Optional — max tokens per LLM reply; must be a positive whole number.
# gpt-oss-120b is a reasoning model; 2048 leaves architecture replies empty.
GROQ_MAX_TOKENS=8192

# Optional — FastEmbed model for indexing and search. Changing it needs a re-index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
